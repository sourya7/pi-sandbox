{
  "policyVersion": 3,
  "enabled": true,
  "failClosed": true,
  "network": {
    "allowLocalBinding": true,
    "allowAllUnixSockets": false,
    "allow": [
      "localhost",
      "127.0.0.1",
      "html.duckduckgo.com",
      "github.com",
      "*.github.com",
      "raw.githubusercontent.com",
      "npmjs.org",
      "*.npmjs.org",
      "registry.npmjs.org",
      "pypi.org",
      "*.pypi.org"
    ],
    "deny": [],
    "otherwise": "prompt"
  },
  "filesystem": {
    "read": {
      "scope": "home",
      "allow": [
        "."
      ],
      "deny": [
        ".env",
        ".env.local",
        ".env.development",
        ".env.production",
        ".env.test",
        "~/.ssh",
        "~/.aws",
        "~/.kube",
        "~/.config/gcloud",
        "~/.pi/agent/auth.json",
        "~/.pi/agent/sessions",
        "~/.pi/agent/archive.db"
      ],
      "otherwise": "prompt"
    },
    "write": {
      "allow": [
        ".",
        "/tmp",
        "~/.cache/uv"
      ],
      "deny": [
        "~/.pi/agent/settings.json",
        "~/.pi/agent/trust.json"
      ],
      "otherwise": "prompt"
    }
  }
}
