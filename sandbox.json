{
  "policyVersion": 2,
  "enabled": true,
  "failClosed": true,
  "network": {
    "allowedDomains": [
      "npmjs.org",
      "*.npmjs.org",
      "registry.npmjs.org",
      "pypi.org",
      "*.pypi.org",
      "github.com",
      "*.github.com",
      "raw.githubusercontent.com"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "readScope": "home",
    "denyRead": [
      "~/.ssh",
      "~/.aws"
    ],
    "allowRead": [
      "."
    ],
    "allowWrite": [
      ".",
      "/tmp"
    ],
    "denyWrite": [
      ".env"
    ]
  }
}
